{
  "name": "project-vault-mcp",
  "version": "0.2.0",
  "description": "Local-first architecture knowledge for any project. Search, link, create and update Markdown notes through MCP.",
  "type": "module",
  "license": "MIT",
  "author": "OzgurH",
  "repository": { "type": "git", "url": "git+https://github.com/OzgurH/project-vault-mcp.git" },
  "bugs": { "url": "https://github.com/OzgurH/project-vault-mcp/issues" },
  "homepage": "https://github.com/OzgurH/project-vault-mcp#readme",
  "engines": { "node": ">=22.12.0" },
  "bin": { "project-vault": "dist/src/cli.js" },
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "files": ["dist/src", "README.md", "LICENSE", "SECURITY.md", "docs/", "examples/", "assets/"],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run build"
  },
  "keywords": ["mcp", "obsidian", "markdown", "architecture", "adr", "knowledge-base", "local-first", "ai-agents"],
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "github-slugger": "2.0.0",
    "minimatch": "10.2.6",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
